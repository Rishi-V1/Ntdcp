{
  "version": "1.0",
  "description": "Deterministic rules used by the correlation engine. 'signature_rules' turn Suricata alerts / Zeek notices into semantic tags; 'technique_rules' turn tags into ATT&CK mappings. Every rule is validated against attack_catalog.json at load time.",
  "signature_rules": [
    {"id": "SIG-SSH-BRUTE", "pattern": "(?i)ssh scan|password_guessing|guessing ssh passwords|brute.?force", "tag": "bruteforce_signature"},
    {"id": "SIG-ADDR-SCAN", "pattern": "(?i)address_scan|unique hosts", "tag": "address_scan_notice"},
    {"id": "SIG-SCAN", "pattern": "(?i)\\bET SCAN\\b|nmap|os detection|port_scan|scanned at least", "tag": "scan_signature"},
    {"id": "SIG-C2", "pattern": "(?i)malware c2|trojan|command and control|\\bc2\\b|ja3", "tag": "c2_signature"},
    {"id": "SIG-DNS-TUNNEL", "pattern": "(?i)dns tunnel", "tag": "dns_tunnel_signature"},
    {"id": "SIG-WEB", "pattern": "(?i)web_server|web application attack|sql injection|xss|web shell", "tag": "web_attack_signature"},
    {"id": "SIG-POLICY", "pattern": "(?i)\\bET (POLICY|INFO)\\b|not suspicious traffic|corporate privacy", "tag": "policy_signature"}
  ],
  "technique_rules": [
    {"id": "MAP-SWEEP", "tags": ["host_sweep", "address_scan_notice"], "tactic": "TA0043", "technique": "T1595.001", "method": "behavioral", "status": "OBSERVED", "confidence": 0.6,
     "reason": "One source contacted many hosts with failed/short connections (address sweep)."},
    {"id": "MAP-PORTSCAN", "tags": ["port_scan", "scan_signature"], "tactic": "TA0007", "technique": "T1046", "method": "signature+behavioral", "status": "OBSERVED", "confidence": 0.75,
     "reason": "Many destination ports probed on the same host, or a scan signature fired."},
    {"id": "MAP-BRUTE", "tags": ["ssh_bruteforce", "bruteforce_signature", "password_guessing_notice"], "tactic": "TA0006", "technique": "T1110.001", "method": "signature+behavioral", "status": "OBSERVED", "confidence": 0.8,
     "reason": "Repeated failed SSH authentications between the same pair of hosts."},
    {"id": "MAP-VALID", "tags": ["auth_success_after_failures"], "tactic": "TA0001", "technique": "T1078", "method": "behavioral", "status": "INFERRED", "confidence": 0.55,
     "reason": "A successful login followed many failures; a guessed valid account is plausible but network data cannot prove the account was misused."},
    {"id": "MAP-WEB", "tags": ["web_attack_signature"], "tactic": "TA0001", "technique": "T1190", "method": "signature", "status": "INFERRED", "confidence": 0.45,
     "reason": "A web-attack signature fired; it shows an attempt, not successful exploitation."},
    {"id": "MAP-C2-SIG", "tags": ["c2_signature"], "tactic": "TA0011", "technique": "T1071.001", "method": "signature", "status": "OBSERVED", "confidence": 0.65,
     "reason": "An IDS signature for known C2 TLS/HTTP traffic matched this flow."},
    {"id": "MAP-BEACON", "tags": ["beacon"], "tactic": "TA0011", "technique": "T1071", "method": "behavioral", "status": "INFERRED", "confidence": 0.45,
     "reason": "Regular, low-jitter outbound connections are consistent with beaconing, but also with legitimate agents."},
    {"id": "MAP-DNS-TUN", "tags": ["dns_tunnel", "dns_tunnel_signature"], "tactic": "TA0011", "technique": "T1071.004", "method": "signature+behavioral", "status": "INFERRED", "confidence": 0.55,
     "reason": "Long, high-entropy DNS labels to one domain are consistent with DNS tunnelling."},
    {"id": "MAP-DNS-EXFIL", "tags": ["dns_tunnel"], "tactic": "TA0010", "technique": "T1048", "method": "behavioral", "status": "INFERRED", "confidence": 0.4,
     "reason": "Data could be leaving inside DNS queries; the payload content is not visible."},
    {"id": "MAP-EXFIL", "tags": ["large_outbound"], "tactic": "TA0010", "technique": "T1048", "method": "behavioral", "status": "INFERRED", "confidence": 0.4,
     "reason": "A large internal-to-external transfer may be exfiltration; the transfer alone does not prove data theft."}
  ]
}
